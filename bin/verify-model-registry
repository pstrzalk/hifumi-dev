#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Read-only check that every model offered by LLM::Stages actually resolves
# through RubyLLM. Burns no tokens and writes nothing.
#
# Usage:
#   bin/verify-model-registry                              # check the offered list
#   bin/verify-model-registry anthropic/claude-opus-5 ...  # also check candidate ids
#
# On a deployed host:
#   kamal app exec --reuse "bin/verify-model-registry"
#
# Why this exists: with acts_as installed, RubyLLM v2 uses the ruby_llm_models
# table as its registry store and falls back to the gem's bundled models.json
# only when that table is empty (models.rb:85-97). A model absent from both
# raises ModelNotFoundError on every RubyLLM-backed stage. Pass candidate ids
# to check a model BEFORE adding it to LLM::Stages::AVAILABLE_MODELS.
#
# See docs/05-runbooks/03-llm-model-registry.md.
#
# Exits non-zero if any id fails to resolve.

require_relative "../config/environment"

candidates = ARGV
offered = LLM::Stages::AVAILABLE_MODELS.keys
failures = []

# RubyLLM wires config.model_registry_store to the ruby_llm_models table from an
# `on_load :active_record` hook, so in a lazy-loading environment the store is
# still nil until something touches ActiveRecord — and RubyLLM::Models would
# silently resolve against the gem's bundled JSON instead of the DB, which is
# the exact confusion this script exists to prevent.
Rails.application.eager_load!
store = RubyLLM.config.model_registry_store

puts "registry store rows: #{store ? store.count : "(no store configured)"}"
puts "resolved registry:   #{RubyLLM::Models.instance.all.size}"

def check(id, failures)
  info, = RubyLLM::Models.resolve(id)
  puts format("  OK    %-32s provider=%-11s ctx=%s", id, info.provider, info.context_window || "?")
rescue StandardError => e
  failures << id
  puts format("  FAIL  %-32s %s", id, e.class)
end

puts "\noffered by LLM::Stages (#{offered.size}):"
offered.each { |id| check(id, failures) }

unless candidates.empty?
  puts "\ncandidates (not yet offered):"
  candidates.each { |id| check(id, failures) }
end

if failures.any?
  puts "\n#{failures.size} id(s) did not resolve: #{failures.join(', ')}"
  puts "Populate the registry with: bin/rails runner 'RubyLLM.models.refresh!'"
  puts "Then restart long-lived processes — the registry is memoized per process."
  exit 1
end

puts "\nall ids resolve."
