#!/usr/bin/env ruby
# frozen_string_literal: true

#
# Read-only check that the RubyLLM registry store is in the state db/seeds.rb
# leaves it in, and that every model LLM::Stages offers resolves from it.
# Burns no tokens and writes nothing.
#
# Usage:
#   bin/verify-model-registry                              # check the offered list
#   bin/verify-model-registry anthropic/claude-opus-5 ...  # also check candidate ids
#
# On a deployed host:
#   kamal app exec --reuse "bin/verify-model-registry"
#
# Why this exists: with acts_as installed, RubyLLM v2 uses the ruby_llm_models
# table as its registry store and falls back to the gem's bundled models.json
# only when that table is empty. db/seeds.rb seeds exactly
# LLM::Stages::AVAILABLE_MODELS under LLM::Stages::PROVIDER, so an empty store
# or a missing row is a setup error, not a warning -- the remedy is
# `bin/rails db:seed`. Pass candidate ids to check a model BEFORE adding it to
# AVAILABLE_MODELS (a candidate absent from the store is expected to fail).
#
# See docs/05-runbooks/03-llm-model-registry.md.
#
# Exits non-zero if the store is empty, lacks an offered id, or any id fails
# to resolve.

require_relative "../config/environment"

# RubyLLM wires config.model_registry_store to the ruby_llm_models table from an
# `on_load :active_record` hook. This script boots via require "config/environment"
# rather than `bin/rails runner`, and that path does not touch ActiveRecord -- so
# without the line below the store is nil and RubyLLM::Models would silently
# resolve against the gem's bundled JSON instead of the DB, which is the exact
# confusion this script exists to prevent. Referencing ActiveRecord::Base fires
# the hook on its own; a full eager_load! is not needed.
ActiveRecord::Base.connection_pool
result = LLM::RegistryCheck.call(candidates: ARGV)

def format_line(resolution)
  if resolution.ok?
    # ctx is "?" on a bare seeded row -- expected; a refresh fills it in.
    format("  OK    %-32s provider=%-11s ctx=%s", resolution.id, resolution.provider, resolution.context_window || "?")
  else
    format("  FAIL  %-32s %s", resolution.id, resolution.error)
  end
end

puts "registry store rows: #{result.store_rows}"
puts "resolved registry:   #{RubyLLM::Models.instance.all.size}"

if result.store_rows.zero?
  puts "\nFAIL: the store is empty, so RubyLLM is resolving against the gem's bundled"
  puts "registry -- which is not what production runs on and whose provider set"
  puts "drifts between gem releases."
elsif result.missing_rows.any?
  puts "\nFAIL: no #{LLM::Stages::PROVIDER} row for: #{result.missing_rows.join(', ')}"
end

puts "\noffered by LLM::Stages (#{result.offered.size}):"
result.offered.each { |r| puts format_line(r) }

unless result.candidates.empty?
  puts "\ncandidates (not yet offered):"
  result.candidates.each { |r| puts format_line(r) }
end

unless result.ok?
  puts "\nPopulate the store with: bin/rails db:seed   (idempotent -- seeds AVAILABLE_MODELS under #{LLM::Stages::PROVIDER})"
  puts "Then restart long-lived processes -- the registry is memoised per process."
  exit 1
end

failed_candidates = result.candidates.reject(&:ok?)
if failed_candidates.any?
  puts "\n#{failed_candidates.size} candidate(s) do not resolve. A non-empty store shadows the gem's bundle,"
  puts "so a candidate resolves only once it has its own #{LLM::Stages::PROVIDER} row: add it to"
  puts "LLM::Stages::AVAILABLE_MODELS, run bin/rails db:seed, and re-run this check."
  exit 1
end

puts "\nall ids resolve from the store."
